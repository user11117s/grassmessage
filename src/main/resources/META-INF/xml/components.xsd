<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns="urn:grassmessage" elementFormDefault="qualified">

    <xs:simpleType name="hexColor">
        <xs:restriction base="xs:string">
            <xs:pattern value="#[0-9a-fA-F]{6}"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="hexColor8">
        <xs:restriction base="xs:string">
            <xs:pattern value="#[0-9a-fA-F]{6}|#[0-9a-fA-F]{8}"/>
        </xs:restriction>
    </xs:simpleType>
    
    <xs:simpleType name="uuid">
        <xs:restriction base="xs:string">
            <xs:pattern value="[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="simpleDuration">
        <xs:restriction base="xs:string">
            <xs:pattern value="(\d+d)?(\d+h)?(\d+m)?(\d+s)?"/>
            <xs:minLength value="1"/>
        </xs:restriction>
    </xs:simpleType>
    
    <xs:simpleType name="varAttr">
        <xs:restriction base="xs:string">
            <xs:pattern value="\$\([^$()]*\)"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:complexType name="empty"/>

    <xs:complexType name="stringDataComponent">
        <xs:simpleContent>
            <xs:extension base="xs:string">
                <xs:attribute name="key" type="xs:string" use="required"/>
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>

    <xs:complexType name="valuedDataComponent">
        <xs:attribute name="key" type="xs:string" use="required"/>
        <xs:attribute name="src" type="varAttr" use="required"/>
    </xs:complexType>

    <xs:complexType name="itemType">
        <xs:sequence>
            <xs:element name="id" type="xs:string"/>
            <xs:element name="count" minOccurs="0">
                <xs:simpleType>
                    <xs:union memberTypes="xs:nonNegativeInteger varAttr"/>
                </xs:simpleType>
            </xs:element>
            <xs:element name="sdata" type="stringDataComponent" minOccurs="0" maxOccurs="unbounded"/>
            <xs:element name="vdata" type="valuedDataComponent" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="entityType">
        <xs:all>
            <xs:element name="type" type="xs:string"/>
            <xs:element name="uuid">
                <xs:simpleType>
                    <xs:union memberTypes="uuid varAttr"/>
                </xs:simpleType>
            </xs:element>
            <xs:element name="name" type="compositeComponent" minOccurs="0"/>
        </xs:all>
    </xs:complexType>

    <!-- Events -->

    <xs:element name="hover">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="content" type="compositeComponent"/>
                <xs:choice>
                    <xs:element name="show_text" type="compositeComponent"/>
                    <xs:element name="show_item" type="itemType">
                        <xs:unique name="uniqueKey">
                            <xs:selector xpath="sdata|vdata"/>
                            <xs:field xpath="@key"/>
                        </xs:unique>
                    </xs:element>
                    <xs:element name="show_entity" type="entityType"/>
                </xs:choice>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="click">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="content" type="compositeComponent"/>
                <xs:choice>
                    <xs:element name="run_command" type="xs:string"/>
                    <xs:element name="suggest_command" type="xs:string"/>
                    <xs:element name="open_url" type="xs:string"/>
                    <xs:element name="open_file" type="xs:string"/>
                    <xs:element name="change_page">
                        <xs:simpleType>
                            <xs:union memberTypes="xs:positiveInteger varAttr"/>
                        </xs:simpleType>
                    </xs:element>
                    <xs:element name="copy_to_clipboard" type="xs:string"/>
                    <xs:element name="custom">
                        <xs:complexType>
                            <xs:sequence>
                                <xs:element name="id" type="xs:string"/>
                                <xs:choice>
                                    <xs:element name="spayload" type="xs:string"/>
                                    <xs:element name="vpayload">
                                        <xs:complexType>
                                            <xs:attribute name="src" type="varAttr" use="required"/>
                                        </xs:complexType>
                                    </xs:element>
                                </xs:choice>
                            </xs:sequence>
                        </xs:complexType>
                    </xs:element>
                    <xs:element name="show_dialog">
                        <xs:complexType>
                            <xs:attribute name="src" type="varAttr" use="required"/>
                        </xs:complexType>
                    </xs:element>
                    <xs:element name="callback">
                        <xs:complexType>
                            <xs:attribute name="src" type="varAttr" use="required"/>
                            <xs:attribute name="uses" default="1">
                                <xs:simpleType>
                                    <xs:union memberTypes="xs:int varAttr"/>
                                </xs:simpleType>
                            </xs:attribute>
                            <xs:attribute name="duration" default="12h">
                                <xs:simpleType>
                                    <xs:union memberTypes="simpleDuration varAttr"/>
                                </xs:simpleType>
                            </xs:attribute>
                        </xs:complexType>
                    </xs:element>
                </xs:choice>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <!-- Styling -->

    <xs:element name="bold" type="compositeComponent"/>
    <xs:element name="b" type="compositeComponent"/>

    <xs:element name="italic" type="compositeComponent"/>
    <xs:element name="i" type="compositeComponent"/>

    <xs:element name="underlined" type="compositeComponent"/>
    <xs:element name="u" type="compositeComponent"/>

    <xs:element name="strikethrough" type="compositeComponent"/>
    <xs:element name="st" type="compositeComponent"/>

    <xs:element name="reset" type="compositeComponent"/>
    <xs:element name="obf" type="compositeComponent"/>

    <xs:element name="font">
        <xs:complexType>
            <xs:complexContent>
                <xs:extension base="compositeComponent">
                    <xs:attribute name="font" type="xs:string" use="required"/>
                </xs:extension>
            </xs:complexContent>
        </xs:complexType>
    </xs:element>

    <xs:element name="insertion">
        <xs:complexType>
            <xs:complexContent>
                <xs:extension base="compositeComponent">
                    <xs:attribute name="text" type="xs:string" use="required"/>
                </xs:extension>
            </xs:complexContent>
        </xs:complexType>
    </xs:element>

    <xs:element name="color">
        <xs:complexType>
            <xs:complexContent>
                <xs:extension base="compositeComponent">
                    <xs:attribute name="hex" use="required">
                        <xs:simpleType>
                            <xs:union memberTypes="hexColor varAttr"/>
                        </xs:simpleType>
                    </xs:attribute>
                </xs:extension>
            </xs:complexContent>
        </xs:complexType>
    </xs:element>

    <xs:element name="shadow">
        <xs:complexType>
            <xs:complexContent>
                <xs:extension base="compositeComponent">
                    <xs:attribute name="color" use="required">
                        <xs:simpleType>
                            <xs:union memberTypes="hexColor8 varAttr"/>
                        </xs:simpleType>
                    </xs:attribute>
                </xs:extension>
            </xs:complexContent>
        </xs:complexType>
    </xs:element>

    <xs:element name="gradref">
        <xs:complexType>
            <xs:simpleContent>
                <xs:extension base="xs:string">
                    <xs:attribute name="ref" type="xs:Name" use="required"/>
                </xs:extension>
            </xs:simpleContent>
        </xs:complexType>
    </xs:element>

    <xs:element name="styleref">
        <xs:complexType>
            <xs:complexContent>
                <xs:extension base="compositeComponent">
                    <xs:attribute name="ref" type="xs:Name" use="required"/>
                </xs:extension>
            </xs:complexContent>
        </xs:complexType>
    </xs:element>

    <!-- Colors -->

    <xs:element name="black" type="compositeComponent"/>
    <xs:element name="dark_blue" type="compositeComponent"/>
    <xs:element name="dark_green" type="compositeComponent"/>
    <xs:element name="dark_aqua" type="compositeComponent"/>
    <xs:element name="dark_red" type="compositeComponent"/>
    <xs:element name="dark_purple" type="compositeComponent"/>
    <xs:element name="gold" type="compositeComponent"/>
    <xs:element name="gray" type="compositeComponent"/>

    <xs:element name="dark_gray" type="compositeComponent"/>
    <xs:element name="blue" type="compositeComponent"/>
    <xs:element name="green" type="compositeComponent"/>
    <xs:element name="aqua" type="compositeComponent"/>
    <xs:element name="red" type="compositeComponent"/>
    <xs:element name="light_purple" type="compositeComponent"/>
    <xs:element name="yellow" type="compositeComponent"/>
    <xs:element name="white" type="compositeComponent"/>

    <!-- Non-text components -->

    <xs:element name="translatable">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="key" type="xs:string"/>
                <xs:element name="with" type="compositeComponent" minOccurs="0" maxOccurs="unbounded"/>
                <xs:element name="fallback" type="xs:string" minOccurs="0"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="keybind" type="xs:string"/>
    <xs:element name="selector" type="xs:string"/>
    <xs:element name="score">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="target" type="xs:string"/>
                <xs:element name="objective" type="xs:string"/>
                <xs:element name="default" type="xs:string" minOccurs="0"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <!-- Utility components -->

    <xs:element name="ln" type="empty">
        <xs:annotation><xs:documentation>
            Creates a new line.
        </xs:documentation></xs:annotation>
    </xs:element>

    <xs:element name="glue" type="empty">
        <xs:annotation><xs:documentation>
            [<a href="$DOCS/Elements.md#glue">Find more here</a>]
            Removes the space between two components (or text) if you insert this element between them.
        </xs:documentation></xs:annotation>
    </xs:element>

    <xs:element name="nbsp">
        <xs:annotation><xs:documentation>
            Adds more than one space between two components (or text) if you insert this element between them.
        </xs:documentation></xs:annotation>
        <xs:complexType>
            <xs:attribute name="spaces" type="xs:positiveInteger" default="1"/>
        </xs:complexType>
    </xs:element>

    <xs:element name="embed_msg">
        <xs:complexType>
            <xs:attribute name="ref" type="xs:Name" use="required"/>
        </xs:complexType>
    </xs:element>

    <xs:element name="adventure">
        <xs:complexType>
            <xs:attribute name="src" type="varAttr" use="required"/>
        </xs:complexType>
    </xs:element>

    <xs:element name="pre">
        <xs:complexType>
            <xs:complexContent>
                <xs:extension base="compositeComponent">
                    <xs:attribute name="dedent" type="xs:boolean" default="true"/>
                    <xs:attribute name="trim_bounds" type="xs:boolean" default="true"/>
                    <xs:attribute name="inline" type="xs:boolean" default="false"/>
                </xs:extension>
            </xs:complexContent>
        </xs:complexType>
    </xs:element>

    <xs:element name="sprite">
        <xs:complexType>
            <xs:attribute name="atlas" type="xs:string"/>
            <xs:attribute name="path" type="xs:string" use="required"/>
        </xs:complexType>
    </xs:element>

    <xs:element name="head">
        <xs:complexType>
            <xs:choice>
                <xs:element name="uuid">
                    <xs:simpleType>
                        <xs:union memberTypes="uuid varAttr"/>
                    </xs:simpleType>
                </xs:element>
                <xs:element name="texture" type="xs:string"/>
                <xs:element name="name" type="xs:string"/>
            </xs:choice>
            <xs:attribute name="outer_layer" type="xs:boolean" default="false"/>
        </xs:complexType>
    </xs:element>

    <!-- Compilation of all allowed components -->

    <xs:complexType name="compositeComponent" mixed="true">
        <xs:sequence minOccurs="0" maxOccurs="unbounded">
            <xs:choice minOccurs="0" maxOccurs="unbounded">
                <xs:element ref="hover"/>
                <xs:element ref="click"/>

                <xs:element ref="b"/>
                <xs:element ref="bold"/>
                <xs:element ref="i"/>
                <xs:element ref="italic"/>
                <xs:element ref="u"/>
                <xs:element ref="underlined"/>
                <xs:element ref="st"/>
                <xs:element ref="strikethrough"/>
                <xs:element ref="reset"/>
                <xs:element ref="obf"/>

                <xs:element ref="font"/>
                <xs:element ref="insertion"/>
                <xs:element ref="color"/>
                <xs:element ref="shadow"/>
                <xs:element ref="gradref"/>
                <xs:element ref="styleref"/>

                <xs:element ref="black"/>
                <xs:element ref="dark_blue"/>
                <xs:element ref="dark_green"/>
                <xs:element ref="dark_aqua"/>
                <xs:element ref="dark_red"/>
                <xs:element ref="dark_purple"/>
                <xs:element ref="gold"/>
                <xs:element ref="gray"/>
                <xs:element ref="dark_gray"/>
                <xs:element ref="blue"/>
                <xs:element ref="green"/>
                <xs:element ref="aqua"/>
                <xs:element ref="red"/>
                <xs:element ref="light_purple"/>
                <xs:element ref="yellow"/>
                <xs:element ref="white"/>

                <xs:element ref="translatable"/>
                <xs:element ref="keybind"/>
                <xs:element ref="selector"/>
                <xs:element ref="score"/>
                <xs:element ref="ln"/>
                <xs:element ref="glue"/>
                <xs:element ref="nbsp"/>
                <xs:element ref="embed_msg"/>
                <xs:element ref="adventure"/>
                <xs:element ref="pre"/>
                <xs:element ref="sprite"/>
                <xs:element ref="head"/>
            </xs:choice>
        </xs:sequence>
    </xs:complexType>
</xs:schema>
