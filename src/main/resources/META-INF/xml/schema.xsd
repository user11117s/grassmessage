<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="urn:grassmessage"
           xmlns="urn:grassmessage" xmlns:gm="urn:grassmessage" xmlns:xi="http://www.w3.org/2001/XInclude"
           xmlns:xml="http://www.w3.org/XML/1998/namespace" elementFormDefault="qualified">

    <xs:include schemaLocation="components.xsd"/>
    <xs:import namespace="http://www.w3.org/2001/XInclude" schemaLocation="https://www.w3.org/2001/xinclude.xsd"/>
    <xs:import namespace="http://www.w3.org/XML/1998/namespace" schemaLocation="https://www.w3.org/2001/xml.xsd"/>

    <!-- ChatGPT carried. I don't know much about XSD. -->
    <!-- Edit: Now I am quite comfortable with it! -->

    <xs:simpleType name="normalizedFloat">
        <xs:restriction base="xs:float">
            <xs:minExclusive value="0"/>
            <xs:maxExclusive value="1"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="flexHexColor">
        <xs:union memberTypes="hexColor varAttr"/>
    </xs:simpleType>

    <!--
    _______________
    Top-level setup
    _______________
    -->

    <xs:element name="message">
        <xs:complexType>
            <xs:complexContent>
                <xs:extension base="compositeComponent">
                    <xs:attribute name="name" type="xs:Name" use="required"/>
                </xs:extension>
            </xs:complexContent>
        </xs:complexType>
    </xs:element>

    <xs:element name="messages">
        <xs:complexType>
            <xs:sequence minOccurs="0" maxOccurs="unbounded">
                <xs:element ref="message"/>
            </xs:sequence>
            <xs:attributeGroup ref="xml:specialAttrs"/>
        </xs:complexType>
    </xs:element>

    <xs:complexType name="middleColorStopType">
        <xs:simpleContent>
            <xs:extension base="flexHexColor">
                <xs:attribute name="position" type="normalizedFloat" use="required"/>
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>

    <xs:element name="gradient">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="start" type="flexHexColor"/>
                <xs:element name="middle" minOccurs="0" maxOccurs="unbounded" type="middleColorStopType"/>
                <xs:element name="end" type="flexHexColor"/>
            </xs:sequence>
            <xs:attribute name="name" type="xs:Name" use="required"/>
        </xs:complexType>
    </xs:element>

    <xs:simpleType name="namedColor">
        <xs:restriction base="xs:string">
            <xs:enumeration value="black"/>
            <xs:enumeration value="dark_blue"/>
            <xs:enumeration value="dark_green"/>
            <xs:enumeration value="dark_aqua"/>
            <xs:enumeration value="dark_red"/>
            <xs:enumeration value="dark_purple"/>
            <xs:enumeration value="gold"/>
            <xs:enumeration value="gray"/>
            <xs:enumeration value="dark_gray"/>
            <xs:enumeration value="blue"/>
            <xs:enumeration value="green"/>
            <xs:enumeration value="aqua"/>
            <xs:enumeration value="red"/>
            <xs:enumeration value="light_purple"/>
            <xs:enumeration value="yellow"/>
            <xs:enumeration value="white"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:element name="style">
        <xs:complexType>
            <xs:attribute name="name" type="xs:string" use="required"/>
            <xs:attribute name="color">
                <xs:simpleType>
                    <xs:union memberTypes="namedColor hexColor"/>
                </xs:simpleType>
            </xs:attribute>
            <xs:attribute name="shadowColor" type="hexColor8"/>
            <xs:attribute name="font" type="xs:string"/>
            <xs:attribute name="bold" type="xs:boolean" default="false"/>
            <xs:attribute name="italic" type="xs:boolean" default="false"/>
            <xs:attribute name="underlined" type="xs:boolean" default="false"/>
            <xs:attribute name="strikethrough" type="xs:boolean" default="false"/>
            <xs:attribute name="obfuscated" type="xs:boolean" default="false"/>
        </xs:complexType>
    </xs:element>

    <xs:element name="gradients">
        <xs:complexType>
            <xs:sequence minOccurs="0" maxOccurs="unbounded">
                <xs:element ref="gradient"/>
            </xs:sequence>
            <xs:attributeGroup ref="xml:specialAttrs"/>
        </xs:complexType>
    </xs:element>

    <xs:element name="styles">
        <xs:complexType>
            <xs:sequence minOccurs="0" maxOccurs="unbounded">
                <xs:element ref="style"/>
            </xs:sequence>
            <xs:attributeGroup ref="xml:specialAttrs"/>
        </xs:complexType>
    </xs:element>

    <!-- Root -->

    <xs:element name="grass">
        <xs:complexType>
            <xs:choice minOccurs="0" maxOccurs="unbounded">
                <xs:element ref="messages"/>
                <xs:element ref="gradients"/>
                <xs:element ref="styles"/>
                <xs:element ref="xi:include"/>
            </xs:choice>
        </xs:complexType>

        <xs:key name="msgNames">
            <xs:selector xpath="gm:messages/gm:message"/>
            <xs:field xpath="@name"/>
        </xs:key>
        <xs:key name="gradientNames">
            <xs:selector xpath="gm:gradients/gm:gradient"/>
            <xs:field xpath="@name"/>
        </xs:key>
        <xs:key name="styleNames">
            <xs:selector xpath="gm:styles/gm:style"/>
            <xs:field xpath="@name"/>
        </xs:key>
        <xs:keyref name="msgInstances" refer="gm:msgNames">
            <xs:selector xpath=".//gm:embed_msg"/>
            <xs:field xpath="@ref"/>
        </xs:keyref>
        <xs:keyref name="gradInstances" refer="gm:gradientNames">
            <xs:selector xpath=".//gm:gradref"/>
            <xs:field xpath="@ref"/>
        </xs:keyref>
        <xs:keyref name="styleInstances" refer="gm:styleNames">
            <xs:selector xpath=".//gm:styleref"/>
            <xs:field xpath="@ref"/>
        </xs:keyref>
    </xs:element>
</xs:schema>