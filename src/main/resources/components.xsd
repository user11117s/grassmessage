<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

    <xs:simpleType name="hexColor">
        <xs:restriction base="xs:string">
            <xs:pattern value="#[0-9a-fA-F]{6}"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="hexColor8">
        <xs:restriction base="xs:string">
            <xs:pattern value="#[0-9a-fA-F]{6}|#[0-9a-fA-F]{8}"/>
        </xs:restriction>
    </xs:simpleType>
    
    <xs:simpleType name="uuid">
        <xs:restriction base="xs:string">
            <xs:pattern value="[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="simpleDuration">
        <xs:restriction base="xs:string">
            <xs:pattern value="(\d+d)?(\d+h)?(\d+m)?(\d+s)?"/>
            <xs:minLength value="1"/>
        </xs:restriction>
    </xs:simpleType>
    
    <xs:simpleType name="varAttr">
        <xs:restriction base="xs:string">
            <xs:pattern value="\$\([^$()]*\)"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:complexType name="empty"/>

    <xs:element name="component" type="xs:anyType" abstract="true"/>

    <xs:complexType name="stringDataComponent">
        <xs:simpleContent>
            <xs:extension base="xs:string">
                <xs:attribute name="key" type="xs:string" use="required"/>
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>

    <xs:complexType name="valuedDataComponent">
        <xs:attribute name="key" type="xs:string" use="required"/>
        <xs:attribute name="var" type="xs:string" use="required"/>
    </xs:complexType>

    <xs:complexType name="compositeComponent" mixed="true">
        <xs:sequence minOccurs="0" maxOccurs="unbounded">
            <xs:element ref="component"/>
        </xs:sequence>
    </xs:complexType>

    <xs:element name="show_item">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="id" type="xs:string"/>
                <xs:element name="count" minOccurs="0">
                    <xs:simpleType>
                        <xs:union memberTypes="xs:nonNegativeInteger varAttr"/>
                    </xs:simpleType>
                </xs:element>
                <xs:element name="sdata" type="stringDataComponent" minOccurs="0" maxOccurs="unbounded"/>
                <xs:element name="vdata" type="valuedDataComponent" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
        </xs:complexType>
        <xs:unique name="uniqueKey">
            <xs:selector xpath="sdata|vdata"/>
            <xs:field xpath="@key"/>
        </xs:unique>
    </xs:element>

    <xs:complexType name="entityType">
        <xs:all>
            <xs:element name="type" type="xs:string"/>
            <xs:element name="uuid">
                <xs:simpleType>
                    <xs:union memberTypes="uuid varAttr"/>
                </xs:simpleType>
            </xs:element>
            <xs:element name="name" type="compositeComponent" minOccurs="0"/>
        </xs:all>
    </xs:complexType>

    <!-- Events -->

    <xs:element name="hover" substitutionGroup="component">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="content" type="compositeComponent"/>
                <xs:choice>
                    <xs:element name="show_text" type="compositeComponent"/>
                    <xs:element ref="show_item"/>
                    <xs:element name="show_entity" type="entityType"/>
                </xs:choice>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="click" substitutionGroup="component">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="content" type="compositeComponent"/>
                <xs:choice>
                    <xs:element name="run_command" type="xs:string"/>
                    <xs:element name="suggest_command" type="xs:string"/>
                    <xs:element name="open_url" type="xs:string"/>
                    <xs:element name="open_file" type="xs:string"/>
                    <xs:element name="change_page">
                        <xs:simpleType>
                            <xs:union memberTypes="xs:positiveInteger varAttr"/>
                        </xs:simpleType>
                    </xs:element>
                    <xs:element name="copy_to_clipboard" type="xs:string"/>
                    <xs:element name="custom">
                        <xs:complexType>
                            <xs:sequence>
                                <xs:element name="id" type="xs:string"/>
                                <xs:element name="payload" type="xs:string"/>
                            </xs:sequence>
                        </xs:complexType>
                    </xs:element>
                    <xs:element name="show_dialog">
                        <xs:complexType>
                            <xs:attribute name="var" type="xs:string" use="required"/>
                        </xs:complexType>
                    </xs:element>
                    <xs:element name="callback">
                        <xs:complexType>
                            <xs:attribute name="var" type="xs:string" use="required"/>
                            <xs:attribute name="uses" default="1">
                                <xs:simpleType>
                                    <xs:union memberTypes="xs:int varAttr"/>
                                </xs:simpleType>
                            </xs:attribute>
                            <xs:attribute name="duration" default="12h">
                                <xs:simpleType>
                                    <xs:union memberTypes="simpleDuration varAttr"/>
                                </xs:simpleType>
                            </xs:attribute>
                        </xs:complexType>
                    </xs:element>
                </xs:choice>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <!-- Styling -->

    <xs:element name="bold" substitutionGroup="component" type="compositeComponent"/>
    <xs:element name="b" substitutionGroup="component" type="compositeComponent"/>

    <xs:element name="italic" substitutionGroup="component" type="compositeComponent"/>
    <xs:element name="i" substitutionGroup="component" type="compositeComponent"/>

    <xs:element name="underlined" substitutionGroup="component" type="compositeComponent"/>
    <xs:element name="u" substitutionGroup="component" type="compositeComponent"/>

    <xs:element name="strikethrough" substitutionGroup="component" type="compositeComponent"/>
    <xs:element name="st" substitutionGroup="component" type="compositeComponent"/>

    <xs:element name="reset" substitutionGroup="component" type="compositeComponent"/>
    <xs:element name="obf" substitutionGroup="component" type="compositeComponent"/>

    <xs:element name="font" substitutionGroup="component">
        <xs:complexType>
            <xs:complexContent>
                <xs:extension base="compositeComponent">
                    <xs:attribute name="font" type="xs:string" use="required"/>
                </xs:extension>
            </xs:complexContent>
        </xs:complexType>
    </xs:element>

    <xs:element name="insertion" substitutionGroup="component">
        <xs:complexType>
            <xs:complexContent>
                <xs:extension base="compositeComponent">
                    <xs:attribute name="text" type="xs:string" use="required"/>
                </xs:extension>
            </xs:complexContent>
        </xs:complexType>
    </xs:element>

    <xs:element name="color" substitutionGroup="component">
        <xs:complexType>
            <xs:complexContent>
                <xs:extension base="compositeComponent">
                    <xs:attribute name="hex" use="required">
                        <xs:simpleType>
                            <xs:union memberTypes="hexColor varAttr"/>
                        </xs:simpleType>
                    </xs:attribute>
                </xs:extension>
            </xs:complexContent>
        </xs:complexType>
    </xs:element>

    <xs:element name="shadow" substitutionGroup="component">
        <xs:complexType>
            <xs:complexContent>
                <xs:extension base="compositeComponent">
                    <xs:attribute name="color" use="required">
                        <xs:simpleType>
                            <xs:union memberTypes="hexColor8 varAttr"/>
                        </xs:simpleType>
                    </xs:attribute>
                </xs:extension>
            </xs:complexContent>
        </xs:complexType>
    </xs:element>

    <xs:element name="gradref" substitutionGroup="component">
        <xs:complexType>
            <xs:simpleContent>
                <xs:extension base="xs:string">
                    <xs:attribute name="ref" type="xs:Name" use="required"/>
                </xs:extension>
            </xs:simpleContent>
        </xs:complexType>
    </xs:element>

    <xs:element name="styleref" substitutionGroup="component">
        <xs:complexType>
            <xs:complexContent>
                <xs:extension base="compositeComponent">
                    <xs:attribute name="ref" type="xs:Name" use="required"/>
                </xs:extension>
            </xs:complexContent>
        </xs:complexType>
    </xs:element>

    <!-- Colors -->

    <xs:element name="black" substitutionGroup="component" type="compositeComponent"/>
    <xs:element name="dark_blue" substitutionGroup="component" type="compositeComponent"/>
    <xs:element name="dark_green" substitutionGroup="component" type="compositeComponent"/>
    <xs:element name="dark_aqua" substitutionGroup="component" type="compositeComponent"/>
    <xs:element name="dark_red" substitutionGroup="component" type="compositeComponent"/>
    <xs:element name="dark_purple" substitutionGroup="component" type="compositeComponent"/>
    <xs:element name="gold" substitutionGroup="component" type="compositeComponent"/>
    <xs:element name="gray" substitutionGroup="component" type="compositeComponent"/>

    <xs:element name="dark_gray" substitutionGroup="component" type="compositeComponent"/>
    <xs:element name="blue" substitutionGroup="component" type="compositeComponent"/>
    <xs:element name="green" substitutionGroup="component" type="compositeComponent"/>
    <xs:element name="aqua" substitutionGroup="component" type="compositeComponent"/>
    <xs:element name="red" substitutionGroup="component" type="compositeComponent"/>
    <xs:element name="light_purple" substitutionGroup="component" type="compositeComponent"/>
    <xs:element name="yellow" substitutionGroup="component" type="compositeComponent"/>
    <xs:element name="white" substitutionGroup="component" type="compositeComponent"/>

    <!-- Non-text components -->

    <xs:element name="translatable" substitutionGroup="component">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="key" type="xs:string"/>
                <xs:element name="with" type="compositeComponent" minOccurs="0" maxOccurs="unbounded"/>
                <xs:element name="fallback" type="xs:string" minOccurs="0"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="keybind" substitutionGroup="component" type="xs:string"/>
    <xs:element name="selector" substitutionGroup="component" type="xs:string"/>
    <xs:element name="score" substitutionGroup="component">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="target" type="xs:string"/>
                <xs:element name="objective" type="xs:string"/>
                <xs:element name="default" type="xs:string" minOccurs="0"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <!-- Utility components -->

    <xs:element name="ln" substitutionGroup="component" type="empty">
        <xs:annotation><xs:documentation>
            Creates a new line.
        </xs:documentation></xs:annotation>
    </xs:element>

    <xs:element name="glue" substitutionGroup="component" type="empty">
        <xs:annotation><xs:documentation>
            Removes the space between two components (or text) if you insert this element between them.
        </xs:documentation></xs:annotation>
    </xs:element>

    <xs:element name="nbsp" substitutionGroup="component">
        <xs:annotation><xs:documentation>
            Adds more than one space between two components (or text) if you insert this element between them.
        </xs:documentation></xs:annotation>
        <xs:complexType>
            <xs:attribute name="spaces" type="xs:positiveInteger" default="1"/>
        </xs:complexType>
    </xs:element>

    <xs:element name="embed_msg" substitutionGroup="component">
        <xs:complexType>
            <xs:attribute name="ref" type="xs:Name" use="required"/>
        </xs:complexType>
    </xs:element>

    <xs:element name="adventure" substitutionGroup="component">
        <xs:complexType>
            <xs:attribute name="name" type="xs:Name" use="required"/>
        </xs:complexType>
    </xs:element>

    <xs:element name="pre" substitutionGroup="component">
        <xs:complexType>
            <xs:complexContent>
                <xs:extension base="compositeComponent">
                    <xs:attribute name="dedent" type="xs:boolean" default="true"/>
                    <xs:attribute name="trim_bounds" type="xs:boolean" default="true"/>
                    <xs:attribute name="inline" type="xs:boolean" default="false"/>
                </xs:extension>
            </xs:complexContent>
        </xs:complexType>
    </xs:element>

    <xs:element name="sprite" substitutionGroup="component">
        <xs:complexType>
            <xs:attribute name="atlas" type="xs:string"/>
            <xs:attribute name="path" type="xs:string" use="required"/>
        </xs:complexType>
    </xs:element>

    <xs:element name="head" substitutionGroup="component">
        <xs:complexType>
            <xs:choice>
                <xs:element name="uuid">
                    <xs:simpleType>
                        <xs:union memberTypes="uuid varAttr"/>
                    </xs:simpleType>
                </xs:element>
                <xs:element name="texture" type="xs:string"/>
                <xs:element name="name" type="xs:string"/>
            </xs:choice>
            <xs:attribute name="outer_layer" type="xs:boolean" default="false"/>
        </xs:complexType>
    </xs:element>
</xs:schema>
